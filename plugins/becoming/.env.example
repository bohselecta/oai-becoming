# No production defaults or fixture identities. Do not commit .env.
NODE_ENV=production
APP_ORIGIN=https://becoming.example.invalid
OIDC_ISSUER=https://identity.example.invalid
OIDC_CLIENT_ID=replace-with-account-web-client-id
# Optional only if registered as confidential client using client_secret_post
OIDC_CLIENT_SECRET=
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
DATA_KEY=
DATABASE_PATH=/durable/becoming/private.sqlite
PORT=8787
BIND_ADDRESS=127.0.0.1
# Exact external OIDC subjects; separate human reviewers; never grant via MCP
REVIEWER_SUBJECTS=
# Invite-only owner testing before general release. Exact Auth0 user_id values.
# Set PILOT_MODE=true and populate PILOT_SUBJECTS for the hosted pilot.
PILOT_MODE=false
PILOT_SUBJECTS=
# Explicit incoming browser-origin allowlist. Server-to-server clients omit Origin.
ALLOWED_ORIGINS=https://becoming.example.invalid,https://chatgpt.com
# Only if trusted IdP publishes JWKS/token/authorize endpoints on other origins:
OIDC_TRUSTED_ORIGINS=https://identity.example.invalid
